// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Post {
    id        Int      @id @default(autoincrement())
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([name])
}
model User {
    id Int @id @default(autoincrement())
    username String
    password String
    characters Character[]
}

enum Abilities {
    Strength
    Dexterity
    Constitution
    Intelligence
    Wisdom
    Charisma
}

enum Skill {
  Acrobatics
  AnimalHandling
  Arcana
  Athletics
  Deception
  History
  Insight
  Intimidation
  Investigation
  Medicine
  Nature
  Perception
  Performance
  Persuasion
  Religion
  SleightOfHand
  Stealth
  Survival
}

enum Armors {
    Light
    Medium
    Heavy
    Shields
}


enum Languages {
    Common
    Dwarvish
    Elvish
    Gnomish
    Goblin
    Halfling
    Orc
    Draconic
    Sylvan
    Undercommon
}
enum WeaponProperty {
  Simple
  Melee
  Ranged
  Martial
  Finesse
  TwoHanded
  Thrown
  Versatile
  Ammunition
  Loading
  Heavy
  Reach
  Special
}



model Weapon {
  id               Int    @id @default(autoincrement())
  name             String @unique
  cost             Int?
  weight           Int?
  damageDiceNumber Int
  damageDiceFaces  Int
  damageType       String
  minRange         Int?  // Only for ranged/thrown weapons
  maxRange         Int? 
  properties       WeaponProperty[] 
  CharacterWeaponProficiency CharacterWeaponProficiency[]
}

model CharacterWeaponProficiency {
  id          Int    @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id])
  weaponId    Int?   // Nullable - Used if proficiency is for a specific weapon
  weapon      Weapon? @relation(fields: [weaponId], references: [id])
  property    WeaponProperty? // Nullable - Used if proficiency is for a property

  @@index([characterId, property])
  @@unique([characterId, weaponId, property]) // Prevent duplicate proficiencies
}

model Character {
  id    Int @id @default(autoincrement())
  userID    Int
  user  User    @relation(fields: [userID], references: [id])
  classID   Int?
  class Class?  @relation("CharacterClass", fields: [classID], references: [id])
  speciesID Int?
  species   Species? @relation("CharacterSpecies", fields: [speciesID], references: [id])
  backgroundID  Int?
  background    Background? @relation("CharacterBackground", fields: [backgroundID], references: [id])
  subclassID    Int?
  subclass  Subclass? @relation("CharacterSubclass", fields: [subclassID], references: [id])
  AbilityScores Int[]    @default([0,0,0,0,0,0])
  Modifiers Int[]    @default([0,0,0,0,0,0])
  Name  String?  @default("Unknown Character Name")
  Level Int      @default(1)
  SkillProfs    Skill[]
  SavingThrows  Abilities[]
  ArmorProfs    Armors[]
  KnownLanguages    Languages[]
  WeaponProficiencies   CharacterWeaponProficiency[]
}

model Species {
    id Int @id @default(autoincrement())
    Character Character[] @relation("CharacterSpecies")
}

model Class {
    id Int @id @default(autoincrement())
    Character Character[] @relation("CharacterClass")
    
}

model Subclass {
    id Int @id @default(autoincrement())
    Character Character[] @relation("CharacterSubclass")
}

model Background {
    id Int @id @default(autoincrement())
    Character Character[] @relation("CharacterBackground")
}

model Spell {
    id Int @id @default(autoincrement())
    
}

model Ability {
    id Int @id @default(autoincrement())
    
}